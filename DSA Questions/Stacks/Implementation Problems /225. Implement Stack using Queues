class MyStack {
    private Queue<Integer> que;
    public MyStack() {
        que = new LinkedList<>();
    }
    
    public void push(int x) {
        int s = que.size();
        que.add(x);

        for(int i = 0; i < s; i++) {
            que.add(que.remove());
        }
    }
    
    public int pop() {
        return que.remove();
    }
    
    public int top() {
        return que.peek();
    }
    
    public boolean empty() {
        return que.isEmpty();
    }
}
