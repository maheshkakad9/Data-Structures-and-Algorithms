//Stack Using Arrays
class ArrayStack {
    int[] stack;
    int top;
    public ArrayStack() {
        stack = new int[100];
        top = -1;
    }

    public void push(int x) {
        top++;
        stack[top] = x;
    }

    public int pop() {
        return stack[top--];
    }

    public int top() {
        return stack[top];
    }

    public boolean isEmpty() {
        if(top == -1) {
            return true;
        }
        return false;
    }
}
