class LinkedListStack {
    private class Node {
        int data;
        Node next;
        Node(int data) {
            this.data = data;
            this.next = null;
        }
    }
    private Node head;
    public LinkedListStack() {
        head = null;
    }

    public void push(int x) {
       Node newNode = new Node(x);
       newNode.next = head;
       head = newNode;
    }

    public int pop() {
      if(isEmpty()) {
        return -1;
      }
      int val = head.data;
      head = head.next;
      return val;
    }

    public int top() {
        if(isEmpty()) {
            return -1;
        }
        return head.data;
    }

    public boolean isEmpty() {
        if(head == null){
            return true;
        }
        return false;
    }
}
