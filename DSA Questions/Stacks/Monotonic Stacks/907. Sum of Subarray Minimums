//Brute Force
//TC - O(N*2)
//TLE
class Solution {
    public int sumSubarrayMins(int[] arr) {
        int n = arr.length;
        int mod = 1000000007;
        int sum = 0;
        for(int i=0;i<n;i++) {
            int min = Integer.MAX_VALUE;
            for(int j=i;j<n;j++) {
                min = Math.min(min,arr[j]);
                sum = (sum + min) % mod;
            } 
        }
        return sum;
    }
}
