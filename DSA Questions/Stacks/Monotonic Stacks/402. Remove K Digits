//Tc - Overall time Complexity O(n)
//SC - Overall space complexity O(n)
class Solution {
    public String removeKdigits(String num, int k) {
        int n = num.length();
        Stack<Integer> st = new Stack<>();
        if(n == k) {
            return "0";
        }

        for(char ch: num.toCharArray()) {
            while(!st.isEmpty() && k > 0 && st.peek() > ch - '0') {
                st.pop();
                k--;
            }
            st.push(ch-'0');
        }

        while(k > 0) {
            st.pop();
            k--;
        }

        StringBuilder sb = new StringBuilder();
        while(!st.isEmpty()) {
            sb.append(st.pop());
        }

        int m = sb.length();
        while(m > 0 && sb.charAt(m-1) == '0') {
            sb.deleteCharAt(m-1);
            m--;
        }
        sb.reverse();
        return sb.length() == 0 ? "0" : sb.toString();
    }
}
