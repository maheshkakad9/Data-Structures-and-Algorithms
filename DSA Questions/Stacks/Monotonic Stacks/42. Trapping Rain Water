//Using Monotonic Stack (But this is not the ideal solution) 
class Solution {
    public int trap(int[] height) {
        int n = height.length;
        int[] rightGreatestEl = new int[n];
        int[] leftGreatestEl = new int[n];
        Stack<Integer> st = new Stack();
        for(int i=n-1; i>=0; i--) {
            while(!st.isEmpty() && st.peek() <= height[i]) {
                st.pop();
            }
            rightGreatestEl[i] = st.isEmpty() ? -1 : st.peek();
            if(!st.isEmpty() && st.peek() > height[i]) {
                continue;
            }else {
                st.push(height[i]);
            }
        }
        st.clear();
        for(int i=0;i<n;i++) {
            while(!st.isEmpty() && st.peek() <= height[i]) {
                st.pop();
            }
            leftGreatestEl[i] = st.isEmpty() ? -1: st.peek();
            if(!st.isEmpty() && st.peek() > height[i]) {
                continue;
            }else {
                st.push(height[i]);
            }
        }

        int ans = 0;

        for(int i=0;i<n;i++) {
            int currAns = (Math.min(rightGreatestEl[i],leftGreatestEl[i])) - height[i];

            if(currAns <= 0) {
                continue;
            } else {
                ans += currAns;
            }
        }
        return ans;
    }
}

//Optimised Solution
//TC - O(n)
//SC - O(n)
//Using left max and right max array
class Solution {
    public int trap(int[] height) {
        int n = height.length;
        int[] rightMax = new int[n];
        int[] leftMax = new int[n];

        leftMax[0] = height[0];
        for(int i=1; i<n;i++) {
            leftMax[i] = Math.max(leftMax[i-1],height[i]);
        }
        rightMax[n-1] = height[n-1];
        for(int i=n-2;i>=0;i--) {
            rightMax[i] = Math.max(rightMax[i+1],height[i]);
        }
        int ans = 0;
        for(int i=0; i<n; i++) {
            int currAns = Math.min(leftMax[i],rightMax[i]) - height[i];
            if(currAns <= 0) {
                continue;
            } else {
                ans += currAns;
            }
        }
        return ans;
    }
}
