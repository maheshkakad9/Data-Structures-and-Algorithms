class Solution {
    public int findMin(int n) {
        // code here
        int[] currency = {10,5,2,1};
        int coinCount = 0;
        int m = currency.length;
        // int remainder = n;
        for(int i=0;i<m;i++) {
            coinCount += (n / currency[i]);
            n = n % currency[i];
        }
        return coinCount;
    }
}
