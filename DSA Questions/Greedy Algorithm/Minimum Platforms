class Solution {
    public int minPlatform(int arr[], int dep[]) {
        //  code here
        int n = arr.length;
        
        Arrays.sort(arr);
        Arrays.sort(dep);
        
        int platformNeeded = 1;
        int maxPlatforms = 1;
        
        int i = 1;
        int j = 0;
        
        while (i < n && j < n) {
            if (arr[i] <= dep[j]) {
                 platformNeeded++;
                 i++;
            } else {
                platformNeeded--;
                j++;
            }
            maxPlatforms = Math.max(maxPlatforms,platformNeeded);
        }
        return maxPlatforms;
    }
}
