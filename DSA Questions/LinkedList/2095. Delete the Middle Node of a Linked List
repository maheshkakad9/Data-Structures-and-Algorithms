//Brute Force Approached
//TC O(L) + O(L-n-1)
//SC O(1)

class Solution {
    public ListNode deleteMiddle(ListNode head) {
        if(head == null || head.next == null) return null;
        ListNode temp = head;
        int length = 0;
        while(temp != null) {
            length++;
            temp = temp.next;
        }
        temp = head;
        int middle = length / 2;

        for(int i=0; i < middle - 1; i++) {
            temp = temp.next;
        }

        temp.next = temp.next.next;
        return head;
    }
}

