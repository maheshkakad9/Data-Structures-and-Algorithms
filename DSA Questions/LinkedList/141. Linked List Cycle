//Brute Force
//TC - O(n)
//SC - O(n)
public class Solution {
    public boolean hasCycle(ListNode head) {
        HashMap<ListNode,Integer> map = new HashMap<>();

        ListNode temp = head;
        while (temp != null) {
            if(map.containsKey(temp)){
                return true;
            }
            map.put(temp,1);
            temp = temp.next;
        }

        return false;
    }
}


//Optimised Solution
//Using fast and slow pointer 
//If fast == slow that means loop is detected just try to dry run you will understand
//TC - O(n)
// SC - O(1)

public class Solution {
    public boolean hasCycle(ListNode head) {

        ListNode slow = head;
        ListNode fast = head;

        while(fast != null && fast.next != null) {
            slow = slow.next;
            fast = fast.next.next;
            if(slow == fast) return true;
        }

        return false;
    }
}
