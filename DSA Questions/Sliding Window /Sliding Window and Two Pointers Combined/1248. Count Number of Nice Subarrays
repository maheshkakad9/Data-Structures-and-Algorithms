//Brute Force Solution
//TLE
class Solution {
    public int numberOfSubarrays(int[] nums, int k) {
        int n = nums.length;
        int count = 0;
        for(int i=0;i<n;i++) {
            int sum = 0;
            for(int j=i;j<n;j++) {
                sum += (nums[j] % 2);
                if(sum == k) {
                    count++;
                }
            }
        }
        return count;
    }
}

//Optimised Solution using Prefix Sum 
TC - O(n)
SC - O(n)
class Solution {
    public int numberOfSubarrays(int[] nums, int k) {
        int n = nums.length;
        int count = 0;
        int sum = 0;
        Map<Integer,Integer> map = new HashMap<>();
        for(int i=0;i<n;i++) {
            sum += nums[i] % 2;
            if(sum == k) {
                count++;
            }
            if(map.containsKey(sum - k)) {
                count += map.get(sum - k);
            }

            map.put(sum,map.getOrDefault(sum,0)+1);
        }
        return count;
    }
}

//Optimised SOlution with optimised space complexity 
//TC - O(2 * 2n)
//SC - O(1)
class Solution {
    public int numberOfSubarrays(int[] nums, int k) {
        return countSubarrays(nums,k) - countSubarrays(nums,k-1);
    }
    private int countSubarrays(int[] nums,int k) {
        int left=0, right=0, sum=0,count=0;
        while(right < nums.length) {
            sum += nums[right] % 2;
            while(sum > k) {
                sum -= nums[left] % 2;
                left = left + 1;
            }
            count = count + (right - left + 1);
            right = right + 1;
        }
        return count;
    }
}
