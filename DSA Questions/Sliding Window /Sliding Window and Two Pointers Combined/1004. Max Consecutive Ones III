class Solution {
    public int longestOnes(int[] nums, int k) {
        // int ans = 0;
        // int n = nums.length;
        // for(int i=0;i<n;i++) {
        //     int length = 0;
        //     int count = 0;
        //     for(int j=i;j<n;j++) {
        //         if(nums[j] == 0) {
        //             count++;
        //         }
        //         if(count > k) {
        //             break;
        //         }
        //         length++;
        //     }
        //     ans = Math.max(ans,length);
        // }
        // return ans;

        int left = 0;
        int right = 0;
        int maxLength = 0;
        int zerosCount = 0;
        while(right < nums.length) {
            if(nums[right] == 0) {
                zerosCount++;
            }
            while(zerosCount > k) {
                if(nums[left] == 0) zerosCount--;
                left++;
            }
            if(zerosCount <= k) {
                int length = right - left + 1;
                maxLength = Math.max(length,maxLength);
            }
            right++;
        }
        return maxLength;
    }
}
